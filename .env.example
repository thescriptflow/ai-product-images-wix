# Image vendor used by the backend. mock returns a preview and does not call a vendor
# or reserve credits. fal calls fal.ai. replicate and photoroom still return a preview.
IMAGE_PROVIDER=mock

# fal accepts either name.
FAL_KEY=
FAL_API_KEY=

REPLICATE_API_TOKEN=
PHOTOROOM_API_KEY=

# Optional scene model. Leave empty to use fal-ai/flux-pro/kontext.
# Set fal-ai/flux-kontext/dev for the cheaper scene model.
FAL_SCENE_MODEL=

# Credits service. Server only. Do not put the key in dashboard code.
CREDITS_API_URL=
CREDITS_API_KEY=

# Wix Single plan product IDs. Leave empty until the plan exists in the app dashboard.
# The pack still shows, and its Buy credits button stays disabled until the ID is set.
CREDIT_PACK_20_PRODUCT_ID=
CREDIT_PACK_60_PRODUCT_ID=
CREDIT_PACK_150_PRODUCT_ID=
# Optional JSON override. A key present here replaces the matching variable above.
# CREDIT_PACKS=[{"key":"20","productId":""},{"key":"60","productId":""},{"key":"150","productId":""}]
# false charges the prices configured in the Wix app dashboard. Anything else uses the $0 test checkout.
BILLING_TEST_CHECKOUT=true
