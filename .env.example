# Image vendor used by the backend. mock returns a preview and does not call a vendor.
# fal, replicate, and photoroom also return a preview in this build. They read the
# matching key so you can confirm it is present before wiring a live model call.
IMAGE_PROVIDER=mock

# fal accepts either name.
FAL_KEY=
FAL_API_KEY=

REPLICATE_API_TOKEN=
PHOTOROOM_API_KEY=
