# Image vendor used by the backend. mock returns a preview and does not call a vendor
# or reserve credits. fal calls fal.ai. replicate and photoroom still return a preview.
IMAGE_PROVIDER=mock

# fal accepts either name.
FAL_KEY=
FAL_API_KEY=

REPLICATE_API_TOKEN=
PHOTOROOM_API_KEY=

# Optional scene model. Leave empty to use fal-ai/flux-pro/kontext.
# Set fal-ai/flux-kontext/dev for the cheaper scene model.
FAL_SCENE_MODEL=

# Credits service. Server only. Do not put the key in dashboard code.
CREDITS_API_URL=
CREDITS_API_KEY=
